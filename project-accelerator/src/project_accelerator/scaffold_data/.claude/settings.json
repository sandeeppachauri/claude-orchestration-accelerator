{
  "permissions": {
    "allow": [
      "Bash(python -m pytest tests -q)",
      "Bash(pytest -q)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/log_pre_tool_use.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind_doc_sync.sh"
          }
        ]
      }
    ]
  },
  "allowedMcpServers": [
    "example-illustrative-server"
  ]
}
